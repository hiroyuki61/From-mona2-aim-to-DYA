#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/studio_unlock.h> // Studio有効化に必要

// --- 日本語キーボード(JIS)用の定義 (旧環境の値を優先) ---
#define JP_DQUOTE      AT
#define JP_AMPERSAND   CARET
#define JP_QUOTE       AMPERSAND
#define JP_EQUAL       UNDER
#define JP_CARET       EQUAL
#define JP_YEN         INT3
#define JP_PLUS        COLON
#define JP_TILDE       PLUS
#define JP_PIPE        LS(INT3)
#define JP_AT          LBKT
#define JP_COLON       SQT
#define JP_ASTERISK    DQT
#define JP_UNDERSCORE  INT1
#define JP_GRAVE       LS(RBKT)
#define JP_LBRACKET    RBKT
#define JP_RBRACKET    BSLH
#define JP_LPAREN      ASTERISK
#define JP_RPAREN      LPAR
#define JP_LBRACE      RBRC
#define JP_RBRACE      PIPE

// レイヤー番号の定義
#define L_BASE     0
#define L_NUM      1
#define L_SYMBOL   2
#define L_ARROW    3
#define L_FUNCTION 4
#define L_MOUSE    5
#define L_SCROLL   6

/ {
    combos {
        compatible = "zmk,combos";
        combo_tab { bindings = <&kp TAB>; key-positions = <11 12>; };
        combo_shift_tab { bindings = <&kp LS(TAB)>; key-positions = <12 13>; };
        combo_esc { bindings = <&kp ESC>; key-positions = <0 1>; };
        layer4_ESC { bindings = <&lt L_FUNCTION ESC>; key-positions = <39 38>; };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to L_BASE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        app_switch: app_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>; tap-ms = <100>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp TAB>, <&macro_tap &sk LALT>, <&macro_release &kp LALT>;
        };

        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp JP_LPAREN &kp JP_RPAREN &kp LEFT_ARROW>;
        };

        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp JP_LBRACKET &kp JP_RBRACKET &kp LEFT_ARROW>;
        };

        bspc_macro: bspc_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp BSPC>, <&macro_pause_for_release>, <&macro_release &kp BSPC>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <165>;
            bindings = <&mo>, <&to_layer_0>;
        };

        bspc_main: bspc_main {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&bspc_single LSHFT BSPC>, <&bspc_repeat_hold 0 BSPC>;
        };

        bspc_single: bspc_single {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        bspc_repeat_hold: bspc_repeat_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <30>;
            bindings = <&bspc_macro>, <&kp>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
            tap-ms = <20>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E       &kp R          &kp T                                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D       &kp F          &kp G                                   &kp LS(LG(S))                 &kp H        &kp J  &kp K      &kp L    &lt L_FUNCTION JP_MINUS
&mt LSHFT Z       &kp X         &kp C       &kp V          &kp B        &mkp LCLK                  &paren_pair                   &kp N        &kp M  &kp COMMA  &kp DOT  &lt L_ARROW JP_SLASH
&lt L_ARROW F10   &kp LGUI      &kp LALT    &lt L_SYMBOL SPACE  &lt L_FUNCTION SPACE  &mt LCTRL LC(SPACE)    &bspc_main  &lt L_NUM ENTER                       &studio_unlock
            >;
            sensor-bindings = <&rsr_vol>;
        };

        layer_num {
            bindings = <
&kp F1            &kp F2        &kp F3      &kp F4         &kp F5                                                  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3 &kp NUMBER_4  &kp NUMBER_5            &kp LC(LA(KP_NUMBER_0))         &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LSHFT         &kp LC(X)     &kp LC(C)   &kp LC(V)      &kp NUMBER_5  &trans    &trans                          &kp JP_SLASH  &kp JP_CARET  &kp JP_TILDE  &kp JP_AT     &kp JP_UNDERSCORE
&trans            &trans        &trans      &kp F7         &kp LSHFT     &kp F8    &trans       &trans                                                               &kp F1
            >;
            sensor-bindings = <&rsr_vol>;
        };

        layer_symbol {
            bindings = <
&kp ESC           &mkp MB4      &mkp MB5    &kp LC(F)      &kp LC(G)                                               &kp JP_AMPERSAND  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_UNDERSCORE  &kp PERCENT
&kp LC(A)         &mkp MB3      &mkp MB2    &mkp MB1       &kp JP_QUOTE            &trans                          &kp JP_PIPE       &kp JP_LPAREN    &kp UP_ARROW     &kp JP_RPAREN      &kp JP_HASH
&mt LSHFT LC(Z)   &kp LC(X)     &kp LC(C)   &kp LC(V)      &kp LC(B)     &bootloader  &bracket_pair                &kp JP_TILDE      &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW    &kp LS(JP_SLASH)
&kp LCTRL         &trans        &trans      &trans         &trans        &trans       &kp BSPC      &kp DEL                                                                            &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_arrow {
            bindings = <
&kp ESC           &mkp MB4      &mkp MB5    &kp LC(F)      &kp LC(G)                                               &trans        &kp HOME      &kp UP_ARROW  &kp END        &none
&kp LC(A)         &mkp MB3      &mkp MB2    &mkp MB1       &kp LA(F5)              &trans                          &kp BSPC      &trans        &kp UP_ARROW  &trans         &none
&kp LC(Z)         &kp LC(X)     &kp LC(C)   &kp LC(V)      &trans        &trans    &trans                          &kp DEL       &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none
&kp LCTRL         &kp LSHFT     &kp LG(TAB) &trans         &trans        &trans    &kp BSPC      &kp DEL                                                                     &kp K_MUTE
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        layer_function {
            bindings = <
&kp ESC           &trans        &trans      &trans         &trans                                                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans            &mkp MB3      &mkp MB2    &mkp MB1       &trans                  &trans                          &trans        &mkp MB1      &trans        &mkp MB2      &trans
&mt LSHFT LC(Z)   &kp LC(X)     &kp LC(C)   &kp LC(V)      &kp LC(B)     &bootloader  &trans                       &trans        &kp HOME      &trans        &kp END       &bt BT_CLR
&kp LCTRL         &trans        &kp LALT    &trans         &trans        &trans       &trans        &trans                                                                 &bt BT_CLR_ALL
            >;
            sensor-bindings = <&rsr_vol>;
        };

        MOUSE {
            bindings = <
&kp ESC           &trans        &trans      &trans         &trans                                                  &trans        &trans        &trans        &trans        &trans
&trans            &mkp MB3      &mkp MB2    &mkp MB1       &trans                  &trans                          &trans        &mkp MB1      &mkp MB2      &mkp MB3      &trans
&kp LSHFT         &trans        &trans      &trans         &trans        &mkp LCLK    &trans                       &trans        &trans        &trans        &trans        &trans
&trans            &trans        &trans      &trans         &trans        &trans       &trans        &trans                                                                 &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans            &trans        &trans      &trans         &trans                                                  &trans        &trans        &trans        &trans        &trans
&trans            &trans        &trans      &trans         &trans                  &trans                          &trans        &trans        &trans        &trans        &trans
&trans            &trans        &trans      &trans         &trans        &trans       &trans                       &trans        &trans        &trans        &trans        &trans
&trans            &trans        &trans      &trans         &trans        &trans       &trans        &trans                                                                 &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};