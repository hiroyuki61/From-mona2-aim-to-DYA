#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
//#include <dt-bindings/zmk/studio_unlock.h>

/* マウス・スクロールレイヤー番号の定義 */
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";
        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };
        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
// 丸括弧 () のマクロ
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            label = "PAREN_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(NUMBER_8) &kp LS(NUMBER_9) &kp LEFT>;
        };
        
// 角括弧 [] のマクロ
        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            label = "BRACKET_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp JP_LBRACKET &kp JP_RBRACKET &kp LEFT>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };

        // DYA Studio対応: ランタイム回転
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
            tap-ms = <20>;
        };

        // メインのtap-dance: 1回タップと2回目の判定
        bspc_main: bspc_main {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKSPACE_MAIN";
            #binding-cells = <0>;
            tapping-term-ms = <100>;  // 2回目のタップを検出するため比較的長く設定
            bindings = <&bspc_single LEFT_SHIFT BACKSPACE>, <&bspc_repeat_hold 0 BACKSPACE>;
        };

        // 1回目: 通常のhold-tap（タップ=バックスペース、ホールド=シフト）
        bspc_single: bspc_single {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_SINGLE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <20>;     // 50→20msでホールド検出、素早いシフト反応
            quick-tap-ms = <0>;
            require-prior-idle-ms = <10>;  //0->10     
            bindings = <&kp>, <&kp>;
        };

        // 2回目: バックスペースのhold-tap（タップ=バックスペース、ホールド=バックスペース連打）
        bspc_repeat_hold: bspc_repeat_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_REPEAT_HOLD";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <50>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            bindings = <&bspc_macro>, <&kp>;
        };
        // バックスペース連打用マクロ
        bspc_macro: bspc_macro {
            compatible = "zmk,behavior-macro";
            label = "BACKSPACE_MACRO";
            #binding-cells = <0>;
            bindings = <&macro_press &kp BACKSPACE>
                    , <&macro_pause_for_release>
                    , <&macro_release &kp BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E            &kp R          &kp T                                                         &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S             &kp D            &kp F          &kp G                          &lt L_FUNCTION JP_COLON        &kp H        &kp J  &kp K      &kp L    &lt L_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X             &kp C            &kp V          &kp B        &mkp LCLK                    &paren_pair               &kp N        &kp M  &kp COMMA  &kp DOT  &lt L_ARROW SLASH
&lt L_ARROW LG(LS(LEFT_ARROW))      &kp LEFT_GUI     &kp LEFT_ALT    &lt L_ARROW F10       &lt L_SCROLL SPACE           &mt LEFT_CONTROL LC(SPACE)  &bspc_main   &lt L_NUM ENTER                                                                       &kp PRINTSCREEN
            >;
            sensor-bindings = <&rsr_vol>;
        };

        NUM {
            bindings = <
&kp F1            &kp F2           &kp F3           &kp F4           &kp F5                                                       &kp F6        &kp F7             &kp F8          &kp F9           &kp F10
&kp NUMBER_1      &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_4     &kp NUMBER_5                                 &kp JP_YEN  &kp NUMBER_6  &kp NUMBER_7       &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0
&kp LEFT_SHIFT    &kp LC(X)        &kp LC(C)        &kp LC(V)        &kp NUMBER_5    &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp SLASH  &kp JP_CARET       &kp JP_TILDE     &kp JP_AT       &kp JP_UNDERSCORE
&trans            &trans           &trans           &kp F7           &kp LEFT_SHIFT  &kp F8                       &trans             &trans                                                      &studio_unlock
            >;
            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND          &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp MINUS  &kp UNDERSCORE
&kp GRAVE        &kp TILDE    &kp DOUBLE_QUOTES  &kp SQT     &trans                  &trans   &mkp MB3   &mkp MB1       &mkp MB2      &kp EQUAL  &kp PLUS
&kp F1           &kp F2       &kp F3             &kp F4      &kp F5        &kp F11    &kp F12  &kp F6     &kp F7         &kp F8        &kp F9     &kp F10
&trans           &trans       &trans             &trans      &trans        &trans     &trans   &trans                                             &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        ARROW {
            bindings = <
&kp ESC           &mkp MB4     &mkp MB5     &kp LC(F)   &kp LC(G)                               &trans         &kp HOME         &kp UP_ARROW     &kp END           &none
&kp LC(A)         &mkp MCLK    &mkp RCLK    &mkp LCLK   &kp LA(F5)              &trans       &kp BACKSPACE  &trans           &kp UP_ARROW     &trans   &none
&kp LC(Z)         &kp LC(X)    &kp LC(C)    &kp LC(V)   &trans      &trans      &trans       &kp DEL        &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW   &none
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LG(TAB)  &trans   &trans      &trans      &kp BACKSPACE  &kp DEL                                                             &kp K_MUTE
            >;
            sensor-bindings = <&rsr_vol>;
        };

        FUNCTION {
            bindings = <
&kp ESC               &trans        &trans        &trans        &trans                                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans                &mkp MCLK     &mkp RCLK     &mkp LCLK     &trans                   &trans       &trans        &mkp LCLK        &trans        &mkp RCLK        &trans
&mt LEFT_SHIFT LC(Z)   &kp LC(X)    &kp LC(C)     &kp LC(V)     &kp LC(B)   &bootloader  &trans       &trans        &kp HOME      &trans     &kp END        &bt BT_CLR
&kp LEFT_CONTROL      &trans        &kp LEFT_ALT  &trans        &trans      &trans       &trans       &trans                                                  &bt BT_CLR_ALL
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&kp ESC                &mkp MB4        &mkp MB5          &kp LC(F)      &kp LC(G)                                     &kp JP_AMPERSAND  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_UNDERSCORE  &kp PERCENT
&kp LC(A)              &mkp MCLK       &mkp RCLK         &mkp LCLK      &kp JP_QUOTE    &trans      &kp SEMICOLON     &kp JP_PIPE       &kp JP_LPAREN    &kp UP_ARROW     &kp JP_RPAREN       &kp HASH
&mt LEFT_SHIFT LC(Z)   &kp LC(X)       &kp LC(C)         &kp LC(V)      &kp LC(B)       &trans      &bracket_pair  &kp JP_TILDE      &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW    &kp LS(SLASH)
&kp LEFT_CONTROL       &trans          &trans            &trans         &trans          &trans      &kp BACKSPACE             &kp DEL                                                                 &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};